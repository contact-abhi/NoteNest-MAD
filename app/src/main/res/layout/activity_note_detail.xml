<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_500"
        android:elevation="4dp" />

    <!-- Main Content with ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- VIEW MODE CONTAINER -->
            <LinearLayout
                android:id="@+id/viewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Note Title -->
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.01" />

                <!-- Section Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@color/purple_500"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/sectionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/purple_500"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Timestamp -->
                <TextView
                    android:id="@+id/timestampText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:layout_marginBottom="16dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:layout_marginBottom="16dp" />

                <!-- Note Content -->
                <TextView
                    android:id="@+id/contentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnBackground"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp"
                    android:textIsSelectable="true" />

                <!-- Attachments Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attachments"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"
                    android:layout_marginBottom="12dp" />

                <!-- Attachments Container -->
                <LinearLayout
                    android:id="@+id/attachmentsViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- EDIT MODE CONTAINER -->
            <LinearLayout
                android:id="@+id/editContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Title Edit -->
                <EditText
                    android:id="@+id/titleEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/note_title_hint"
                    android:inputType="text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:padding="12dp"
                    android:background="@drawable/button_background"
                    android:maxLines="2" />

                <!-- Section Edit -->
                <EditText
                    android:id="@+id/sectionEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/note_section_hint"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:padding="12dp"
                    android:background="@drawable/button_background"
                    android:maxLines="1" />

                <!-- Content Edit -->
                <EditText
                    android:id="@+id/contentEdit"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:hint="@string/note_content_hint"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:background="@drawable/button_background"
                    android:gravity="top"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:spacing="12dp">

        <!-- View Mode Buttons -->
        <LinearLayout
            android:id="@+id/viewButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:spacing="12dp">

            <!-- Edit Button -->
            <Button
                android:id="@+id/editButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <!-- Delete Button -->
            <Button
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/white"
                android:backgroundTint="@color/red_500" />

        </LinearLayout>

        <!-- Edit Mode Buttons (initially hidden) -->
        <LinearLayout
            android:id="@+id/editButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:spacing="12dp"
            android:visibility="gone">

            <!-- Save Button -->
            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_500"
                android:layout_marginEnd="8dp" />

            <!-- Cancel Button -->
            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:backgroundTint="#999999" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
