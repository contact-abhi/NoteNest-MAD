<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main Theme with Material 3 Design -->
    <style name="Theme.NoteNest" parent="Theme.MaterialComponents.Light">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorPrimaryContainer">@color/purple_300</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorSecondaryContainer">@color/purple_300</item>
        
        <!-- Surface and Background -->
        <item name="colorSurface">@color/light_card</item>
        <item name="colorSurfaceVariant">@color/light_divider</item>
        <item name="android:colorBackground">@color/light_bg</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        
        <!-- On Colors -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorOnBackground">@color/light_text_primary</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        
        <!-- Action Bar -->
        <item name="actionBarSize">56dp</item>
        <item name="toolbarStyle">@style/Widget.Toolbar</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.Toolbar" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="elevation">4dp</item>
        <item name="android:background">@color/purple_500</item>
    </style>

    <!-- Button Style - Rounded -->
    <style name="Widget.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Text Input Style -->
    <style name="Widget.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/purple_500</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
    </style>
</resources>
